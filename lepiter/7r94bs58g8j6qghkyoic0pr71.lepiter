								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.276398+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.276398+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "fbQiZ/buRYOY20w2fc/wUQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Option A. A top-level function becomes a `FAMIXFunction` whose `container` is its file's namespace, or nil for a file without a `package` line (the same as classes in such files). It gets the same source anchor, signature, parameters and declared types as a method, via {{gtMethod:GtSmaCCKotlinImporter>>ensureFunctionFrom:in:}}."
						}
					]
				},
