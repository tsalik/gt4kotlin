							"uid" : {
								"__type" : "uid",
								"uidString" : "3qzFMXJYSamoybN13Sf32A=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The model matches the Kotlin source: no class that does not exist in the code, and `namespace functions` lists a package's functions."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:07.028422+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:07.028422+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "7+i85UjzQHiX8DQz4Mm0bg=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Code that reached the file or namespace through `parentType` must get them another way for functions: type lookup uses {{gtMethod:GtSmaCCKotlinImporter>>lookupTypeNamed:inFile:namespace:}}, and locals ask the function for its `container`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:07.060222+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:07.060222+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "QEBKDa+BQeqEFUyPoieeBw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Java↔Kotlin access is not modelled. It would need one shared `MooseModel` and namespace tree for both importers, Kotlin invocations, and a derived `<File>Kt` view over the functions. That view can be added on top of this decision without undoing it."
						}
					]
				},
