					"__type" : "textStyle"
				},
				"string" : "## Status"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.179932+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.179932+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "u/vpIvN9QPO5Wyiku9vrEA=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Kotlin allows functions outside any class. The importer crashed on them: it built a `FAMIXMethod` and passed the file's namespace as `parentType:`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.211645+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.211645+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "m2LKApR0QWWlzBcxdKifTw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "On the JVM, top-level functions compile to static methods of a facade class `<File>Kt`. `@file:JvmName` renames it, `@JvmMultifileClass` merges several files into one class, extension receivers become a first parameter, and top-level properties become `getX()`/`setX()`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.220921+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.220921+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "hy0rajW5Q7WbreOJGRcvXQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "{{gtClass:GtJavaMethodVisitor}} resolves a call by the receiver's type, then that class's `methods` filtered by name and arity. So Java calls to Kotlin would only find `FAMIXMethod`s of a `<File>Kt` `FAMIXClass`. Kotlin-to-Kotlin calls resolve by package and import, not through the facade."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.250459+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-22T00:50:06.250459+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "m1v9J2krRT2eQaFBxS67TQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Options: (A) `FAMIXFunction` in the namespace; (B) `FAMIXMethod`s of a generated `<File>Kt` class."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
