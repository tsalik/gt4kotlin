										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "A `FAMIXFunction` has a `container` (any `FAMIXContainerEntity`, e.g. a namespace, via its `functions` link) and no `parentType`. `isFunction` is defined on `FAMIXEntity`, so it can be sent to methods and functions alike."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-10-22T00:11:21.621892+03:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-10-22T00:11:21.621892+03:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "B3pr9zVySSqaBwBBMO4IFA=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "Code that reaches the file or the namespace through `parentType` (like `lookupTypeNamed:in:`) has to get them another way for functions: the file from `node topParent`, the namespace from the function's container."
									}
								]
							},
