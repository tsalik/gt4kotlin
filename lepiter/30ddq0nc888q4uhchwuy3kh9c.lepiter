											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-10-22T00:11:21.801914+03:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "fRPfxq3zQpm3oqxrGcIpTA=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "`GtJavaMethodVisitor` resolves a call by the receiver's type, then that class's `methods` filtered by name and arity. A Java↔Kotlin model would need one shared `MooseModel` and namespace tree, Kotlin invocations, and a derived `<File>Kt` view over the functions."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
