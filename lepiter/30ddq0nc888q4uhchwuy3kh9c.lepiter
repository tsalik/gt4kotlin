										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "On the JVM, top-level functions become static methods of a facade class `<File>Kt` (renamed by `@file:JvmName`, merged by `@JvmMultifileClass`). Extension receivers become a first parameter; top-level properties become `getX()`/`setX()`."
									},
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-10-22T00:11:21.801914+03:00"
											}
										},
