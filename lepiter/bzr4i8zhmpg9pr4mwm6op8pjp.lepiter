							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "A protocol/category is just a label to group methods together by purpose. Typical names are `accessing`, `initialization`, `testing`, `private`, `examples`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
