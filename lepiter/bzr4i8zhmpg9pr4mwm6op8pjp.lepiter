								"uidString" : "FczlYKPMTxu+LvChzgHDUw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "A method tagged with a `private` protocol does not change the method's visibility. "
						},
						{
							"__type" : "textSnippet",
							"children" : {
