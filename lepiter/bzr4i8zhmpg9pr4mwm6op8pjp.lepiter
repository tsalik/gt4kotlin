							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "**Moose is the analysis platform**: it knows how to hold a model, search it, and show it in GT. It doesn't know anything about the code itself."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
