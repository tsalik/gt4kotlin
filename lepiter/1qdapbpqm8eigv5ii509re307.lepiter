				},
				"string" : "## Decision"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:51.194311+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:51.194311+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "CtYHG1xCRNGjY6302dYKfQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "`model allClasses` still includes objects, since it uses `allWithSubTypesOf: FAMIXClass`. A query by exact type, such as `allWithType: FAMIXClass`, would miss them."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:51.501392+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:51.501392+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "uZKbHQPWSFKcexmhG2Cp1g=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Moose caches its metamodel. A new `MooseEntity` subclass has no description until `MooseModel resetMeta` runs, and the first `name:` fails with `#allAttributes was sent to nil`. No class-side annotation is needed: `MoosePragmaProcessor` registers a subclass without one under its own class name and Smalltalk superclass. Not yet checked: whether a fresh image that builds the metamodel before loading Gt4Kotlin hits the same error."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:52.126407+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:52.126407+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "GxrgfzhuSmu8D9HZjOEBQQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "To find the right call shape, platform importers will also need annotations such as `@JvmStatic`, `@JvmField`, `@JsExport`, `@JsName` and `@ObjCName`. These are not modelled yet."
						}
					]
				},
