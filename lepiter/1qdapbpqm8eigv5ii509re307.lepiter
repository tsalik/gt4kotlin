				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "## Context"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:48.882474+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:48.882474+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "dc0vb5W2Q6q15fx0ti1j5g=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Option B. A named `object` becomes a {{gtClass:GtKotlinObject}} in its namespace, created by {{gtMethod:GtSmaCCKotlinImporter>>createObjectFrom:in:}}. Its supertypes and scope are handled like a class's in {{gtMethod:GtSmaCCKotlinImporter>>visitObjectDeclaration:}}."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.303054+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.303054+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "9AnONmfETdaTwH2PEbobzw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "`GtKotlinObject>>isKotlinObject` answers true, and `FAMIXClass>>isKotlinObject` is an extension in Gt4Kotlin that answers false. The selector is `isKotlinObject`, not `isObject`: in Smalltalk everything is an object, and it matches `isRubyClass`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.70003+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.70003+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "zeDERfY/QZ2D/xZnZQ5Fmw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Being an object is fixed by which class the importer instantiates, so it can't drift the way a property could. Platform importers can add behaviour to `GtKotlinObject` without `isKotlinObject ifTrue:` branches."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.971409+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-30T17:47:49.971409+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "q2bnxBhkRjOgpyoZyjStJQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "The core model records only Kotlin facts. How each platform reaches the instance is left to the platform importers."
						}
					]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-10-30T17:46:48.020923+02:00"
					}
				},
				"editEmail" : {
