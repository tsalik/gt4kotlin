							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "FAMIX 3 has no \"implements\". An interface supertype is an ordinary {{gtClass:FAMIXInheritance}} whose superclass has `isInterface` set."
						},
						{
							"__type" : "textSnippet",
							"children" : {
