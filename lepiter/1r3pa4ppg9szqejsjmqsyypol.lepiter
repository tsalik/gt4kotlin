								"__type" : "uid",
								"uidString" : "adzY+TV9ShCxPCNLYZvCjQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Java keeps `extends` and `implements` in separate slots (`superclass`, `interfaces`, and `interfaceTypes` for interfaces). Kotlin has a single list, `annotatedSpecifiers`."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-12T00:50:14.18802+03:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-12T00:50:14.18802+03:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "6yP4/LGQTluXtS+m8Fu5TQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Each entry of `annotatedSpecifiers` is a {{gtClass:KotlinAnnotatedDelegationSpecifierNode}} whose `specifier` has one of three shapes: {{gtClass:KotlinConstructorInvocationNode}} for `Base()`, {{gtClass:KotlinExplicitDelegationNode}} for `Base by impl`, or a bare {{gtClass:KotlinUserTypeNode}} for `Base`. The first two answer the type node through `type`."
						}
					]
