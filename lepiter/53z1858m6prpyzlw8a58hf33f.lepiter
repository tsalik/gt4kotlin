							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "I've found out that {{gtClass:KotlinIdentifierNode}}is not the proper way to do it. Import declarations also have a `KotlinIdentifierNode` named path, which has the import name."
						},
