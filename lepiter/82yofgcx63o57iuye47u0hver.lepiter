							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "`anObject ifNil: [ ... ]` answers the receiver when it is not nil, so `import alias ifNil: [ import path names last ]` picks one of two tokens in a single expression."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-10-11T22:44:23.8103+03:00"
								}
							},
