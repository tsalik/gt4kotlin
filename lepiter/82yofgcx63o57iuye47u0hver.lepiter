							"uid" : {
								"__type" : "uid",
								"uidString" : "+xGJLnH5S5mOEF25l8t13g=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Unary messages bind tighter than keyword messages. The parentheses in `(import alias ifNil: [ ... ]) source` are needed, otherwise source goes to the block."
						},
						{
							"__type" : "textSnippet",
							"children" : {
