				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "This project aims to build `GtSmaCCKotlinImporter`, a Glamorous Toolkit(GT) library  that turns a Kotlin codebase into a Moose/FAMIX model so Kotlin projects can be analyzed in GT."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
