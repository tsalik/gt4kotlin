					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-09-27T23:41:35.552494+03:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-09-27T23:51:21.020877+03:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "HIJex7JCT7ivFw9OrD0Q1A=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "This is also a ***learning*** project: The aim is to learn more about GT, Moldable Development, Pharo, SmaCC, FAMIX/Moose and how the existing importers work. "
			},
