						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-09-27T23:51:56.174648+03:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2026-09-27T23:53:00.954547+03:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "Ww0UORrsQZyuL1PeNx/jUw=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "At the time of writing no examples exist for the `GtSmaCCJavaImporter`. Along with the library's examples, I will create the relevant Java examples to inspect the Java Moose model and use as a guide  to Kotlin."
			}
		]
